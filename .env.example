# EmailJS credentials for the contact form.
# Create a free account at https://www.emailjs.com/, add an email service and a
# template, then copy the IDs/keys below. Copy this file to `.env` and fill in.
#
# Your EmailJS template must reference these variables to match the form fields:
#   {{name}}  {{email}}  {{subject}}  {{message}}

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
